@host = http://localhost:5237
# Tokens come from a git-ignored file named .env next to this file, one line per user:
#   TOKEN_USER1=eyJ...   TOKEN_USER2=eyJ...   TOKEN_READER=eyJ...
# To act as another user, change the name below to TOKEN_USER2 or TOKEN_READER.
@token = {{$dotenv TOKEN_USER1}}

### Health
GET {{host}}/health

### Upload an invoice (PDF)
POST {{host}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=X

--X
Content-Disposition: form-data; name="file"; filename="invoice-01.pdf"
Content-Type: application/pdf

< ../DocIntake.Tests/TestData/invoice/invoice-01.pdf
--X--

### Upload a text file (TXT)
POST {{host}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=X

--X
Content-Disposition: form-data; name="file"; filename="bank-statement-03.txt"
Content-Type: text/plain

< ../DocIntake.Tests/TestData/bank-statement/bank-statement-03.txt
--X--

### Unsupported type (expect 415)
POST {{host}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=X

--X
Content-Disposition: form-data; name="file"; filename="photo.png"
Content-Type: image/png

fake image bytes
--X--

### List documents (page 1, 20 per page)
GET {{host}}/documents?page=1&pageSize=20
Authorization: Bearer {{token}}

### Get one document (change the id)
GET {{host}}/documents/1
Authorization: Bearer {{token}}

### Missing document (expect 404)
GET {{host}}/documents/999999
Authorization: Bearer {{token}}

### Download original (open in a browser instead to see the PDF viewer)
GET {{host}}/documents/1/file
Authorization: Bearer {{token}}

### Delete a document (removes row and blob)
DELETE {{host}}/documents/1
Authorization: Bearer {{token}}

### Delete again (expect 404)
DELETE {{host}}/documents/1
Authorization: Bearer {{token}}

### Extract (let the extractor classify)
POST {{host}}/documents/4/extract
Authorization: Bearer {{token}}

### Extract with the type chosen by the user
POST {{host}}/documents/1/extract
Authorization: Bearer {{token}}
Content-Type: application/json

{ "documentType": "Invoice" }

### Confirm after extracting an invoice (valid data -> 200). Run extract on the document first.
POST {{host}}/documents/3/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "acknowledgeIssues": false,
  "data": {
    "vendorName": "Stub Supply Co.", "invoiceNumber": "STUB-0001", "invoiceDate": "2026-01-15", "dueDate": "2026-02-14",
    "currency": "USD", "billTo": "Sample Customer LLC",
    "lineItems": [
      { "description": "Sample item", "quantity": 2, "unitPrice": 50.00, "amount": 100.00 },
      { "description": "Second item", "quantity": 1, "unitPrice": 25.00, "amount": 25.00 }
    ],
    "subtotal": 125.00, "tax": 10.94, "total": 135.94
  }
}

### Confirm with a wrong total, not acknowledged (expect 409 with the issue)
POST {{host}}/documents/2/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "acknowledgeIssues": false,
  "data": {
    "vendorName": "Stub Supply Co.", "invoiceNumber": "STUB-0001", "invoiceDate": "2026-01-15", "dueDate": "2026-02-14",
    "currency": "USD", "billTo": "Sample Customer LLC",
    "lineItems": [
      { "description": "Sample item", "quantity": 2, "unitPrice": 50.00, "amount": 100.00 },
      { "description": "Second item", "quantity": 1, "unitPrice": 25.00, "amount": 25.00 }
    ],
    "subtotal": 125.00, "tax": 10.94, "total": 999.00
  }
}

### Same wrong total, acknowledged (expect 200)
POST {{host}}/documents/1/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "acknowledgeIssues": true,
  "data": {
    "vendorName": "Stub Supply Co.", "invoiceNumber": "STUB-0001", "invoiceDate": "2026-01-15", "dueDate": "2026-02-14",
    "currency": "USD", "billTo": "Sample Customer LLC",
    "lineItems": [
      { "description": "Sample item", "quantity": 2, "unitPrice": 50.00, "amount": 100.00 },
      { "description": "Second item", "quantity": 1, "unitPrice": 25.00, "amount": 25.00 }
    ],
    "subtotal": 125.00, "tax": 10.94, "total": 999.00
  }
}

### Malformed data (missing fields, expect 400)
POST {{host}}/documents/1/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{ "acknowledgeIssues": true, "data": { "vendorName": "X" } }

### Confirm a BANK STATEMENT (use the id of an extracted bank statement; the body must match the document type)
POST {{host}}/documents/4/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "acknowledgeIssues": false,
  "data": {
    "institutionName": "Stub Community Bank", "accountHolder": "Sample Account Holder", "accountType": "Checking", "accountNumberMasked": "1234",
    "periodStart": "2026-01-01", "periodEnd": "2026-01-31", "currency": "USD", "openingBalance": 1000.00, "closingBalance": 1380.00,
    "transactions": [
      { "date": "2026-01-05", "description": "Deposit", "amount": 500.00 },
      { "date": "2026-01-10", "description": "Purchase", "amount": -120.00 }
    ]
  }
}
