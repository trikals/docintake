{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Storage": {
    "BucketName": "",
    "Region": "us-east-2"
  },
  "Auth": {
    "ScopeClaim": "scope"
  },
  "Extraction": {
    "Provider": "Stub"
  },
  "TextExtraction": {
    "MaxPages": 20,
    "MaxCharacters": 60000
  },
  "Quotas": {
    "DailyExtractions": 20
  },
  "RateLimit": {
    "PermitsPerMinute": 10
  }
}
